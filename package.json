{
  "name": "sample",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "npm run test:unit && npm run check && npm run build && node --test tests/*.test.mjs && node scripts/test-base-paths.mjs",
    "preview": "astro preview",
