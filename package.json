    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "embla-carousel": "8.6.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.3",
    "typescript": "^6.0.3"
  }
}
