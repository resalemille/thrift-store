---
interface Props {
  label: string;
  spacious?: boolean;
}
const { label, spacious = false } = Astro.props;
---

<div
  class:list={[
    'grid gap-2 py-5 sm:grid-cols-[11rem_1fr]',
    { 'sm:gap-6': spacious },
  ]}
>
  <dt class="font-bold text-stone-500">{label}</dt>
  <dd class="min-w-0 space-y-2 break-words leading-7 text-ink-950">
    <slot />
  </dd>
</div>
