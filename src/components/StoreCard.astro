---
import type { Store } from '../data/site';
import { link } from '../lib/paths';
const { store } = Astro.props as { store: Store };
---
<article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm"><p class="text-sm font-medium text-ink-700">{store.area}</p><h3 class="mt-2 text-xl font-bold text-ink-950">{store.name}</h3><p class="mt-4 text-sm leading-6 text-stone-600">{store.address}</p><dl class="mt-5 grid gap-2 border-t border-stone-100 pt-4 text-sm"><div class="flex gap-4"><dt class="w-16 text-stone-400">電話</dt><dd>{store.phone}</dd></div><div class="flex gap-4"><dt class="w-16 text-stone-400">営業時間</dt><dd>{store.hours}</dd></div></dl><a href={link(`/stores/${store.slug}/`)} class="mt-6 inline-flex font-bold text-ink-800">店舗詳細を見る →</a></article>
