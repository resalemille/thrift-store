---
import type { Case } from '../data/site';
import { link } from '../lib/paths';
const { item } = Astro.props as { item: Case };
---

<article
  class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm"
>
  <div class="h-44 bg-white">
    <img
      src={link(item.image)}
      alt={item.imageAlt}
      width={item.imageWidth}
      height={item.imageHeight}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-contain"
    >
  </div>
  <div class="p-5">
    <div class="flex items-center justify-between text-xs">
      <span class="rounded-full bg-ink-50 px-3 py-1 font-bold text-ink-800"
        >{item.item}</span
      ><time class="text-stone-400">{item.date}</time>
    </div>
    <h3 class="mt-4 font-bold leading-6 text-ink-950">{item.title}</h3>
    <p class="mt-3 text-sm text-stone-500">{item.brand} / {item.store}</p>
    <p class="mt-2 text-lg font-bold text-ink-800">
      参考価格 ¥{item.price.toLocaleString()}
    </p>
    <a
      href={link(`/cases/${item.slug}/`)}
      class="mt-4 inline-flex text-sm font-bold text-ink-800"
      >詳細を見る →</a
    >
  </div>
</article>
