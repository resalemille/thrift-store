---
import { link } from '../lib/paths';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['consignment-contacts', { compact }]}>
  <a href={link('/contact/')}
    >無料でWeb査定・ご相談<span aria-hidden="true">›</span></a
  >
</div>
<style>
.consignment-contacts {
  display: flex;
  justify-content: center;
}
a {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  min-height: 56px;
  padding: 12px 28px;
  border: 3px double #b5a77a;
  background: #fffdf8;
  color: #594621;
  text-decoration: none;
  font-weight: 700;
}
a:focus-visible {
  outline: 3px solid #b5a77a;
  outline-offset: 4px;
}
.compact a {
  padding: 8px 12px;
  font-size: 12px;
}
</style>
