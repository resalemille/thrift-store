---
interface Props {
  name: 'mail' | 'phone' | 'line' | 'camera' | 'watch' | 'handshake';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'mail' && (
    <>
      <rect x="5" y="10" width="38" height="28" rx="2" />
      <path d="m6 12 18 14 18-14M6 36l13-13m23 13L29 23" />
    </>
  )}
  {name === 'phone' && (
    <path d="m13 5 8 9-5 6c3 6 6 9 12 12l6-5 9 8-4 7c-2 3-7 2-11 0C15 36 7 28 3 15 2 11 3 8 6 7l7-2Z" />
  )}
  {name === 'line' && (
    <>
      <path d="M43 21c0 10-10 17-26 22l3-7C10 35 5 29 5 21 5 11 14 5 24 5s19 6 19 16Z" />
      <text
        x="24"
        y="25"
        fill="currentColor"
        stroke="none"
        font-size="10"
        font-family="sans-serif"
        font-weight="700"
        text-anchor="middle"
      >
        LINE
      </text>
    </>
  )}
  {name === 'camera' && (
    <>
      <path d="M5 15h10l4-7h10l4 7h10v27H5V15Z" />
      <circle cx="24" cy="28" r="10" />
      <path d="M9 11h5M20 3h8M10 19h3" />
    </>
  )}
  {name === 'watch' && (
    <>
      <path d="m17 12 2-9h10l2 9m-14 24 2 9h10l2-9" />
      <circle cx="24" cy="24" r="15" />
      <path d="M24 14v10l7 4m11-7v6" />
    </>
  )}
  {name === 'handshake' && (
    <>
      <path d="m4 12 9-4 8 4 8-4 15 9-6 13-6 3-6 6-8-3-8-9-6-15Z" />
      <path d="m21 12-7 9c-1 3 3 5 5 3l6-6 12 12m-20 0 9 9m-3-13 10 9m-6-13 10 10M4 12l6 15m28 3 6-13" />
    </>
  )}
</svg>
