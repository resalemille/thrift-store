---
import FaqItem from '../components/FaqItem.astro';
import Layout from '../layouts/Layout.astro';
import CategoryLink from '../components/CategoryLink.astro';
import BrandIcon from '../components/BrandIcon.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CaseCard from '../components/CaseCard.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import { cases } from '../data/cases';
import { faqs } from '../data/faqs';
import { items } from '../data/items';
import { news } from '../data/news';
import { site } from '../data/site';
import { stores } from '../data/stores';
import { link } from '../lib/paths';

const featuredItems = items.filter((item) => item.featured);

const reasons = [
  {
    icon: 'crown',
    title: '高価買取の実績',
    description: '専門鑑定士が価値を正確に見極め、最高価格を提示します。',
  },
  {
    icon: 'collection',
    title: '幅広い買取対象',
    description: 'ブランド品から貴金属、骨董品まで、多彩なアイテムに対応。',
  },
  {
    icon: 'shield',
    title: '安心・誠実な対応',
    description: 'お客様の「想い」を尊重し、丁寧で透明性の高い査定。',
  },
];
const conditions = [
  {
    title: '切れたアクセサリー',
    description:
      '片方だけのピアスや、留め具が壊れたネックレスもご相談ください。',
    image: '切れたネックレスと片方のピアス',
    position: 0,
  },
  {
    title: '傷・汚れのあるブランド品',
    description: '使用感のあるバッグや小物も、状態を確認して査定します。',
    image: '傷や使用感のある茶色のバッグ',
    position: 1,
  },
  {
    title: '動かない時計・カメラ',
    description: '故障や長期保管で動かないお品物も、そのままお持ちください。',
    image: '止まった腕時計と古いカメラ',
    position: 2,
  },
  {
    title: '古いお酒・付属品がない品',
    description: '箱や保証書がなくても、まずは実物を拝見してご案内します。',
    image: '古いお酒と付属品のない時計の箱',
    position: 3,
  },
];
---

<Layout>
  <section class="home-hero" aria-labelledby="hero-title">
    <img
      src={link('/images/hero-resale-mille.webp')}
      alt="アンティーク家具と時計、バッグ、宝石、陶磁器のある落ち着いた空間"
      class="hero-photo"
      width="2172"
      height="724"
      fetchpriority="high"
    >
    <div class="hero-content">
      <h1 id="hero-title">
        <span>あなたの「想い」を、<wbr>次の世代へ繋ぐ。</span
        ><span>大切なモノを、<wbr>価値あるカタチで。</span>
      </h1>
      <p>
        高級ブランド・貴金属・宝石・時計・骨董品の高価買取専門店
        {site.shortName}
      </p>
      {/* biome-ignore lint/a11y/useSemanticElements: リンクのグループでありフォームのfieldsetではない */}
      <div
        class="hero-actions"
        role="group"
        aria-label="査定・店舗・出張買取のご案内"
      >
        <a href={link('/contact/')} class="framed-button"
          >無料でWeb査定・ご相談<span aria-hidden="true">›</span></a
        >
        <a href={link('/stores/')} class="framed-button"
          >店舗を予約する<span aria-hidden="true">›</span></a
        >
        <a href={link('/contact/')} class="framed-button"
          >出張買取を予約する<span aria-hidden="true">›</span></a
        >
      </div>
    </div>
  </section>

  <section class="reasons-section silk-panel" aria-labelledby="reasons-title">
    <h2 id="reasons-title" class="ornament-title">
      <span>{site.shortName}</span> <span>が選ばれる理由</span>
    </h2>
    <div class="reason-grid">
      {reasons.map((reason) => (
        <article class="reason-card gold-frame">
          <span class="reason-icon">
            <BrandIcon name={reason.icon} />
          </span>
          <h3>【{reason.title}】</h3>
          <p>{reason.description}</p>
        </article>
      ))}
    </div>
    <ul class="service-promises">
      <li>査定・相談無料 <span>費用は一切かかりません</span></li>
      <li>
        完全予約制でスムーズなご案内
        <span>店舗・出張買取は事前にご予約ください</span>
      </li>
      <li>その場で現金化 <span>ご納得後、すぐにお支払い</span></li>
    </ul>
  </section>

  <section class="category-section silk-panel" aria-labelledby="items-title">
    <div class="category-ribbon" aria-hidden="true">
      {featuredItems.map((item) => (
        <span>
          <BrandIcon name={item.slug} />
          <span>{item.name}</span>
        </span>
      ))}
    </div>
    <div class="home-section-inner">
      <h2 id="items-title" class="ornament-title">買取対象カテゴリー一覧</h2>
      <p class="section-lead">
        掲載のないお品物も、まずはお気軽にご相談ください。
      </p>
      <div class="category-grid">
        {featuredItems.map((item) => <CategoryLink item={item} />)}
      </div>
      <a href={link('/items/')} class="section-more">品目一覧を見る →</a>
    </div>
  </section>

  <section class="gold-section" aria-labelledby="gold-title">
    <div class="gold-banner">
      <img
        src={link('/images/gold-resale-mille.webp')}
        alt="金のインゴットと金貨、ネックレス、ダイヤモンドのジュエリー"
        width="2172"
        height="724"
        loading="lazy"
      >
      <div class="gold-copy">
        <p class="eyebrow">GOLD &amp; PRECIOUS METALS</p>
        <h2 id="gold-title">金・貴金属の<br>買取を強化中</h2>
        <p class="gold-offer">査定・相談無料 ／ 一点から歓迎</p>
        <p class="gold-description">
          インゴット、金貨、ジュエリーなど。お品物の状態や付属品の有無にかかわらず、まずは専門スタッフへご相談ください。
        </p>
        <p class="gold-ribbon">その場でご説明・ご納得後にお支払い</p>
        <div class="gold-actions">
          <a href={link('/items/gold/')} class="framed-button"
            >金・貴金属の詳細を見る<span aria-hidden="true">›</span></a
          ><a href={link('/contact/')} class="gold-consult">無料で相談する →</a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="condition-section silk-panel"
    aria-labelledby="condition-title"
  >
    <div class="home-section-inner">
      <p class="eyebrow">CONDITION</p>
      <h2 id="condition-title" class="ornament-title">
        こんな状態のお品物も、まずはご相談ください
      </h2>
      <p class="section-lead">
        傷や破損、付属品がないお品物も、状態を拝見したうえで丁寧にご案内します。
      </p>
      <div class="condition-grid">
        {conditions.map((condition) => (
          <article class="condition-card gold-frame">
            <div class="condition-photo">
              <img
                src={link('/images/condition-resale-mille.webp')}
                alt={condition.image}
                width="2167"
                height="726"
                loading="lazy"
                style={`left: -${condition.position * 100}%`}
              />
            </div>
            <h3>{condition.title}</h3>
            <p>{condition.description}</p>
          </article>
        ))}
      </div>
      <p class="condition-note">
        ※
        お買取りの可否・金額は、お品物の状態や市場状況を確認のうえご案内します。
      </p>
      <a href={link('/contact/')} class="framed-button condition-cta"
        >査定について相談する<span aria-hidden="true">›</span></a
      >
    </div>
  </section>
  <section class="bg-stone-100">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <SectionTitle
          eyebrow="RESULTS"
          title="買取実績"
          lead="最近お買取りしたお品物の一例です。"
        /><a href={link('/cases/')} class="font-bold text-ink-800"
          >実績をもっと見る →</a
        >
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {cases.slice(0, 3).map((item) => <CaseCard item={item} />)}
      </div>
    </div>
  </section>
  <ReviewsCarousel />
  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <SectionTitle
        eyebrow="HOW IT WORKS"
        title="はじめての方も、安心してご相談ください"
        lead="査定額の理由やお品物の扱いについて、わかりやすくご説明します。"
      />
      <ol class="grid gap-4">
        <li class="flex gap-5 rounded-2xl border border-stone-200 p-6">
          <b class="text-3xl text-gold-600">01</b>
          <div>
            <h3 class="font-bold text-ink-950">ご来店・お問い合わせ</h3>
            <p class="mt-2 text-sm leading-6 text-stone-600">
              店舗・出張買取ともに完全予約制です。まずはご予約・お問い合わせください。
            </p>
          </div>
        </li>
        <li class="flex gap-5 rounded-2xl border border-stone-200 p-6">
          <b class="text-3xl text-gold-600">02</b>
          <div>
            <h3 class="font-bold text-ink-950">専門スタッフが査定</h3>
            <p class="mt-2 text-sm leading-6 text-stone-600">
              市場動向とお品物の状態をふまえて丁寧に確認します。
            </p>
          </div>
        </li>
        <li class="flex gap-5 rounded-2xl border border-stone-200 p-6">
          <b class="text-3xl text-gold-600">03</b>
          <div>
            <h3 class="font-bold text-ink-950">ご成約・お支払い</h3>
            <p class="mt-2 text-sm leading-6 text-stone-600">
              金額にご納得いただけた場合のみ、お取引となります。
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <section class="shop-section bg-ink-900">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-5 py-20 lg:grid-cols-[1.1fr_1fr] lg:px-8"
    >
      <div>
        <SectionTitle
          eyebrow="SHOP"
          title="お近くの店舗を予約する"
          lead="店舗での査定・買取は完全予約制です。事前にご予約のうえお越しください。"
        /><a
          href={link('/stores/')}
          class="mt-8 inline-block rounded-full bg-white px-6 py-3 font-bold text-ink-900"
          >店舗一覧を見る</a
        >
      </div>
      <div class="grid gap-3">
        {stores.map((store) => (
          <a
            href={link(`/stores/${store.slug}/`)}
            class="rounded-xl bg-white/10 p-5 text-white"
          >
            <strong>{store.name}</strong>
            <span class="mt-2 block text-sm text-ink-100">
              {store.area} /{' '}
              {store.access.map((route) => (
                <span class="mt-1 block">{route}</span>
              ))}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <SectionTitle eyebrow="FAQ" title="よくある質問" />
        <div class="mt-8 grid gap-3">
          {faqs
            .slice(0, 3)
            .map(([question, answer]) => (
              <FaqItem question={question} answer={answer} variant="card" />
            ))}
        </div>
        <a href={link('/faq/')} class="mt-6 inline-block font-bold text-ink-800"
          >すべての質問を見る →</a
        >
      </div>
      <div>
        <SectionTitle eyebrow="NEWS" title="お知らせ" />
        <div class="mt-8 divide-y divide-stone-200 border-y border-stone-200">
          {news.map((item) => (
            <a href={link('/news/')} class="flex gap-4 py-5">
              <time class="shrink-0 text-sm text-stone-400">{item.date}</time>
              <span>
                <small class="mr-3 rounded bg-stone-100 px-2 py-1 text-xs text-stone-500">
                  {item.category}
                </small>
                {item.title}
              </span>
            </a>
          ))}
        </div>
        <a
          href={link('/news/')}
          class="mt-6 inline-block font-bold text-ink-800"
          >お知らせ一覧を見る →</a
        >
      </div>
    </div>
  </section>
  <section class="bg-gold-100">
    <div class="mx-auto max-w-5xl px-5 py-16 text-center">
      <p class="text-sm font-bold tracking-[0.2em] text-ink-700">CONTACT</p>
      <h2 class="mt-4 text-3xl font-bold text-ink-950">
        まずは、お気軽にご相談ください。
      </h2>
      <p class="mt-4 text-stone-600">
        査定のご相談、出張買取についてのお問い合わせを承ります。
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={`tel:${site.tel.replaceAll('-', '')}`}
          class="rounded-full bg-ink-900 px-7 py-4 font-bold text-white"
          >電話で相談する {site.tel}</a
        ><a
          href={link('/contact/')}
          class="rounded-full border border-ink-900 px-7 py-4 font-bold text-ink-900"
          >フォームで相談する</a
        >
      </div>
    </div>
  </section>
</Layout>
