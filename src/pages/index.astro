---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CaseCard from '../components/CaseCard.astro';
import { cases, faqs, items, news, site, stores } from '../data/site';
import { link } from '../lib/paths';
---

<Layout>
	<section class="relative isolate overflow-hidden bg-emerald-950"><img src={link('/images/hero-shop.png')} alt="ダミーの店舗内観" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-45" /><div class="absolute inset-0 -z-10 bg-gradient-to-r from-emerald-950 via-emerald-950/75 to-emerald-900/20"></div><div class="mx-auto grid min-h-[580px] max-w-7xl content-center px-5 py-20 lg:px-8"><p class="text-sm font-bold tracking-[0.24em] text-amber-200">REUSE & VALUE</p><h1 class="mt-5 max-w-5xl text-4xl font-bold leading-tight tracking-tight text-white sm:text-6xl"><span class="md:whitespace-nowrap">{site.catch}</span><br /><span class="text-emerald-200">納得できる査定を。</span></h1><p class="mt-7 max-w-xl leading-8 text-emerald-50">ブランド品・時計・ジュエリーから、思い出の詰まったお品物まで。一点ずつ大切に、専門スタッフが査定します。</p><div class="mt-10 flex flex-wrap gap-3"><a href={link('/contact/')} class="rounded-full bg-amber-300 px-7 py-4 font-bold text-emerald-950">無料で相談する</a><a href={link('/stores/')} class="rounded-full border border-white/50 px-7 py-4 font-bold text-white">お近くの店舗を探す</a></div></div></section>
	<section class="mx-auto grid max-w-7xl gap-4 px-5 py-8 sm:grid-cols-3 lg:px-8"><div class="rounded-xl bg-emerald-50 p-5"><strong class="block text-2xl text-emerald-900">査定・相談無料</strong><span class="mt-1 block text-sm text-stone-600">費用は一切かかりません</span></div><div class="rounded-xl bg-amber-50 p-5"><strong class="block text-2xl text-emerald-900">予約なしでもOK</strong><span class="mt-1 block text-sm text-stone-600">お気軽にお立ち寄りください</span></div><div class="rounded-xl bg-stone-100 p-5"><strong class="block text-2xl text-emerald-900">その場で現金化</strong><span class="mt-1 block text-sm text-stone-600">ご納得後、すぐにお支払い</span></div></section>
	<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8"><div class="flex flex-wrap items-end justify-between gap-5"><SectionTitle eyebrow="ITEMS" title="こんなお品物をお買取りします" lead="掲載のないお品物も、まずはお気軽にご相談ください。" /><a href={link('/items/')} class="font-bold text-emerald-800">品目一覧を見る →</a></div><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{items.map((item) => <a href={link(`/items/${item.slug}/`)} class={`group flex items-center gap-5 rounded-2xl ${item.color} p-6`}><span class="grid size-16 place-items-center rounded-2xl bg-white text-3xl shadow-sm">{item.icon}</span><span><strong class="block text-lg text-emerald-950">{item.name}</strong><small class="mt-1 block text-stone-600">{item.description}</small></span><span class="ml-auto text-emerald-700">→</span></a>)}</div></section>
	<section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8"><div class="relative isolate overflow-hidden rounded-3xl bg-stone-950 shadow-2xl shadow-stone-950/20"><img src={link('/images/gold-purchase.png')} alt="金のインゴットとジュエリー" class="absolute inset-0 -z-20 h-full w-full object-cover object-left opacity-80" /><div class="absolute inset-0 -z-10 bg-stone-950/50 lg:bg-gradient-to-r lg:from-stone-950/5 lg:via-stone-950/35 lg:to-stone-950"></div><div class="grid min-h-[460px] content-center px-7 py-12 sm:px-12 lg:grid-cols-2 lg:px-16 lg:py-16"><div class="lg:col-start-2"><p class="text-xs font-bold tracking-[0.24em] text-amber-300">GOLD &amp; PRECIOUS METALS</p><h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">金・貴金属の<br /><span class="text-amber-300">買取を強化中</span></h2><p class="mt-6 max-w-lg leading-8 text-stone-200">インゴット、金貨、ジュエリーなど。お品物の状態や付属品の有無にかかわらず、まずは専門スタッフへご相談ください。</p><ul class="mt-7 grid gap-3 text-sm text-stone-100 sm:grid-cols-3"><li class="border-l border-amber-300/80 pl-3">査定・相談無料</li><li class="border-l border-amber-300/80 pl-3">一点から歓迎</li><li class="border-l border-amber-300/80 pl-3">その場でご説明</li></ul><div class="mt-9 flex flex-wrap gap-3"><a href={link('/items/gold/')} class="rounded-full bg-amber-300 px-6 py-3 font-bold text-stone-950">金・貴金属の詳細を見る</a><a href={link('/contact/')} class="rounded-full border border-white/50 px-6 py-3 font-bold text-white">無料で相談する</a></div></div></div></div></section>
	<section class="bg-stone-100"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-8"><div class="grid items-end gap-8 lg:grid-cols-[1fr_auto]"><SectionTitle eyebrow="CONDITION" title="こんな状態のお品物も、まずはご相談ください" lead="傷や破損、付属品がないお品物も、状態を拝見したうえで丁寧にご案内します。" containerClass="max-w-none" titleClass="lg:whitespace-nowrap" /><a href={link('/contact/')} class="mb-1 font-bold text-emerald-800">査定について相談する →</a></div><div class="mt-10 overflow-hidden rounded-3xl bg-white shadow-sm"><img src={link('/images/condition-purchase.png')} alt="切れたネックレス、傷のあるバッグ、古いカメラ、古いお酒" class="h-56 w-full object-cover sm:h-80" /><div class="grid gap-px bg-stone-200 sm:grid-cols-2 lg:grid-cols-4"><div class="bg-white p-6"><span class="text-xs font-bold tracking-[0.18em] text-amber-700">01</span><h3 class="mt-3 font-bold text-emerald-950">切れたアクセサリー</h3><p class="mt-2 text-sm leading-6 text-stone-600">片方だけのピアスや、留め具が壊れたネックレスもご相談ください。</p></div><div class="bg-white p-6"><span class="text-xs font-bold tracking-[0.18em] text-amber-700">02</span><h3 class="mt-3 font-bold text-emerald-950">傷・汚れのあるブランド品</h3><p class="mt-2 text-sm leading-6 text-stone-600">使用感のあるバッグや小物も、状態を確認して査定します。</p></div><div class="bg-white p-6"><span class="text-xs font-bold tracking-[0.18em] text-amber-700">03</span><h3 class="mt-3 font-bold text-emerald-950">動かない時計・カメラ</h3><p class="mt-2 text-sm leading-6 text-stone-600">故障や長期保管で動かないお品物も、そのままお持ちください。</p></div><div class="bg-white p-6"><span class="text-xs font-bold tracking-[0.18em] text-amber-700">04</span><h3 class="mt-3 font-bold text-emerald-950">古いお酒・付属品がない品</h3><p class="mt-2 text-sm leading-6 text-stone-600">箱や保証書がなくても、まずは実物を拝見してご案内します。</p></div></div></div><p class="mt-6 text-center text-sm leading-7 text-stone-600">※ お買取りの可否・金額は、お品物の状態や市場状況を確認のうえご案内します。</p></div></section>
	<section class="bg-stone-100"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-8"><div class="flex flex-wrap items-end justify-between gap-5"><SectionTitle eyebrow="RESULTS" title="買取実績" lead="最近お買取りしたお品物の一例です。" /><a href={link('/cases/')} class="font-bold text-emerald-800">実績をもっと見る →</a></div><div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{cases.slice(0, 3).map((item) => <CaseCard item={item} />)}</div></div></section>
	<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8"><div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]"><SectionTitle eyebrow="HOW IT WORKS" title="はじめての方も、安心してご相談ください" lead="査定額の理由やお品物の扱いについて、わかりやすくご説明します。" /><ol class="grid gap-4"><li class="flex gap-5 rounded-2xl border border-stone-200 p-6"><b class="text-3xl text-amber-600">01</b><div><h3 class="font-bold text-emerald-950">ご来店・お問い合わせ</h3><p class="mt-2 text-sm leading-6 text-stone-600">お近くの店舗へ。出張のご相談も承ります。</p></div></li><li class="flex gap-5 rounded-2xl border border-stone-200 p-6"><b class="text-3xl text-amber-600">02</b><div><h3 class="font-bold text-emerald-950">専門スタッフが査定</h3><p class="mt-2 text-sm leading-6 text-stone-600">市場動向とお品物の状態をふまえて丁寧に確認します。</p></div></li><li class="flex gap-5 rounded-2xl border border-stone-200 p-6"><b class="text-3xl text-amber-600">03</b><div><h3 class="font-bold text-emerald-950">ご成約・お支払い</h3><p class="mt-2 text-sm leading-6 text-stone-600">金額にご納得いただけた場合のみ、お取引となります。</p></div></li></ol></div></section>
	<section class="bg-emerald-900"><div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 lg:grid-cols-[1.1fr_1fr] lg:px-8"><div><SectionTitle eyebrow="SHOP" title="お近くの店舗を探す" lead="お買い物のついでにも、どうぞお気軽にお立ち寄りください。" /><a href={link('/stores/')} class="mt-8 inline-block rounded-full bg-white px-6 py-3 font-bold text-emerald-900">店舗一覧を見る</a></div><div class="grid gap-3">{stores.map((store) => <a href={link(`/stores/${store.slug}/`)} class="rounded-xl bg-white/10 p-5 text-white"><strong>{store.name}</strong><span class="mt-2 block text-sm text-emerald-100">{store.area} / {store.access}</span></a>)}</div></div></section>
	<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8"><div class="grid gap-12 lg:grid-cols-2"><div><SectionTitle eyebrow="FAQ" title="よくある質問" /><div class="mt-8 grid gap-3">{faqs.slice(0, 3).map(([question, answer]) => <details class="rounded-xl border border-stone-200 p-5"><summary class="cursor-pointer font-bold text-emerald-950">{question}</summary><p class="mt-4 text-sm leading-7 text-stone-600">{answer}</p></details>)}</div><a href={link('/faq/')} class="mt-6 inline-block font-bold text-emerald-800">すべての質問を見る →</a></div><div><SectionTitle eyebrow="NEWS" title="お知らせ" /><div class="mt-8 divide-y divide-stone-200 border-y border-stone-200">{news.map((item) => <a href={link('/news/')} class="flex gap-4 py-5"><time class="shrink-0 text-sm text-stone-400">{item.date}</time><span><small class="mr-3 rounded bg-stone-100 px-2 py-1 text-xs text-stone-500">{item.category}</small>{item.title}</span></a>)}</div><a href={link('/news/')} class="mt-6 inline-block font-bold text-emerald-800">お知らせ一覧を見る →</a></div></div></section>
	<section class="bg-amber-100"><div class="mx-auto max-w-5xl px-5 py-16 text-center"><p class="text-sm font-bold tracking-[0.2em] text-emerald-700">CONTACT</p><h2 class="mt-4 text-3xl font-bold text-emerald-950">まずは、お気軽にご相談ください。</h2><p class="mt-4 text-stone-600">査定のご相談、出張買取についてのお問い合わせを承ります。</p><div class="mt-8 flex flex-wrap justify-center gap-3"><a href={`tel:${site.tel.replaceAll('-', '')}`} class="rounded-full bg-emerald-900 px-7 py-4 font-bold text-white">電話で相談する {site.tel}</a><a href={link('/contact/')} class="rounded-full border border-emerald-900 px-7 py-4 font-bold text-emerald-900">フォームで相談する</a></div></div></section>
</Layout>
