---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { stores } from '../../data/site';
import { link } from '../../lib/paths';
export function getStaticPaths() {
  return stores.map((store) => ({
    params: { slug: store.slug },
    props: { store },
  }));
}
const { store } = Astro.props;
---

<Layout title={store.name}
  ><PageHero title={store.name} lead={store.area} eyebrow="SHOP" />
  <section
    class="mx-auto grid max-w-5xl gap-10 px-5 py-16 lg:grid-cols-[1fr_1.1fr]"
  >
    <img
      src={link(store.image)}
      alt={`${store.name}が入る建物の外観`}
      width={store.imageWidth}
      height={store.imageHeight}
      class="h-auto w-full self-start rounded-2xl object-cover"
      style={{
        aspectRatio: `${store.imageContentWidth ?? store.imageWidth} / ${store.imageHeight}`,
        objectPosition: store.imagePosition ?? 'center',
      }}
    >
    <div>
      <h2 class="text-2xl font-bold text-ink-950">店舗情報</h2>
      <dl
        class="mt-6 divide-y divide-stone-200 border-y border-stone-200 text-sm"
      >
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="font-bold text-stone-500">住所</dt>
          <dd>{store.address}</dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="font-bold text-stone-500">電話番号</dt>
          <dd>
            <a href={`tel:${store.phone.replaceAll('-', '')}`}>{store.phone}</a>
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="font-bold text-stone-500">営業時間</dt>
          <dd>{store.hours}</dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="font-bold text-stone-500">アクセス</dt>
          <dd class="grid gap-2">
            {store.access.map((route: string) => <p>{route}</p>)}
          </dd>
        </div>
      </dl>
      <p class="mt-6 text-sm text-stone-600">
        店舗での査定・買取は完全予約制です。事前にご予約のうえお越しください。
      </p>
      <a
        href={link('/contact/')}
        class="mt-8 inline-block rounded-full bg-ink-800 px-6 py-3 font-bold text-white"
        >この店舗に相談する</a
      >
    </div>
  </section></Layout
>
