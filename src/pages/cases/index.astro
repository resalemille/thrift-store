---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CaseCard from '../../components/CaseCard.astro';
import { cases, items } from '../../data/site';
---

<Layout title="買取実績"
  ><PageHero
    title="買取実績"
    lead="お買取りしたお品物と参考価格をご紹介します。価格は状態や時期により変動します。"
    eyebrow="PURCHASE RESULTS"
  />
  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="flex flex-wrap gap-2">
      <span class="rounded-full bg-ink-800 px-4 py-2 text-sm text-white"
        >すべて</span
      >{items.map((item) => (
        <span class="rounded-full border border-stone-200 px-4 py-2 text-sm text-stone-600">
          {item.name}
        </span>
      ))}
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {cases.map((item) => <CaseCard item={item} />)}
    </div>
  </section></Layout
>
