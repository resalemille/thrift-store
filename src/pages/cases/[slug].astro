---
import Layout from '../../layouts/Layout.astro';
import { cases } from '../../data/site';
import { link } from '../../lib/paths';
export function getStaticPaths() {
  return cases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}
const { item } = Astro.props;
---

<Layout title={item.title}
  ><article class="mx-auto max-w-4xl px-5 py-16">
    <a href={link('/cases/')} class="text-sm font-bold text-ink-800"
      >← 買取実績一覧へ</a
    >
    <div class="mt-8 grid gap-10 lg:grid-cols-2">
      <div class="aspect-square overflow-hidden rounded-3xl bg-white">
        <img
          src={link(item.image)}
          alt={item.imageAlt}
          width={item.imageWidth}
          height={item.imageHeight}
          decoding="async"
          class="h-full w-full object-contain"
        >
      </div>
      <div>
        <p class="text-sm font-bold text-ink-700">{item.item} / {item.brand}</p>
        <h1 class="mt-4 text-3xl font-bold leading-tight text-ink-950">
          {item.title}
        </h1>
        <p class="mt-5 leading-8 text-stone-600">{item.description}</p>
        <div class="mt-8 rounded-2xl bg-ink-50 p-6">
          <p class="text-sm text-ink-800">買取参考価格</p>
          <p class="mt-1 text-3xl font-bold text-ink-900">
            ¥{item.price.toLocaleString()}
          </p>
          <p class="mt-3 text-xs text-stone-500">
            {item.date}
            / {item.store}　※ダミーの掲載内容です。
          </p>
        </div>
      </div>
    </div>
    <section class="mt-16 border-t border-stone-200 pt-10">
      <h2 class="text-2xl font-bold text-ink-950">査定のポイント</h2>
      <p class="mt-4 leading-8 text-stone-600">
        ブランド、状態、付属品、市場の需要などを総合的に確認します。箱や保証書、替えベルトなどがある場合は、あわせてお持ちいただくことをおすすめします。
      </p>
    </section>
  </article></Layout
>
