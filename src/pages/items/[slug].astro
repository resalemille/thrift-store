---
import Layout from '../../layouts/Layout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { cases, items } from '../../data/site';
import { link } from '../../lib/paths';
export function getStaticPaths() { return items.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
const purchaseExamples = cases.filter((purchaseCase) => purchaseCase.item === item.name);
---

<Layout title={item.name}>
	<section class={`px-5 py-20 ${item.color}`}>
		<div class="mx-auto max-w-4xl text-center">
			<span class="text-7xl">{item.icon}</span>
			<p class="mt-5 text-xs font-bold tracking-[0.2em] text-ink-700">ITEM CATEGORY</p>
			<h1 class="mt-3 text-4xl font-bold text-ink-950">{item.name}</h1>
			<p class="mt-5 text-stone-600">{item.description}を中心に、幅広くお取り扱いしています。</p>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-5 py-16">
		<h2 class="text-2xl font-bold text-ink-950">査定のポイント</h2>
		<div class="mt-6 grid gap-4 sm:grid-cols-3">
			<div class="rounded-xl bg-stone-100 p-5"><b class="block text-ink-900">状態</b><p class="mt-2 text-sm leading-6 text-stone-600">傷や使用感がある品もご相談ください。</p></div>
			<div class="rounded-xl bg-stone-100 p-5"><b class="block text-ink-900">付属品</b><p class="mt-2 text-sm leading-6 text-stone-600">箱や保証書があれば一緒にお持ちください。</p></div>
			<div class="rounded-xl bg-stone-100 p-5"><b class="block text-ink-900">市場動向</b><p class="mt-2 text-sm leading-6 text-stone-600">最新の市場価格を査定に反映します。</p></div>
		</div>
	</section>

	{purchaseExamples.length > 0 && <section class="bg-stone-100"><div class="mx-auto max-w-4xl px-5 py-16"><p class="text-xs font-bold tracking-[0.2em] text-ink-700">PURCHASE EXAMPLES</p><h2 class="mt-3 text-2xl font-bold text-ink-950">{item.name}の買取実績</h2><p class="mt-3 text-sm leading-7 text-stone-600">買取のResale Mille（リセールミル）では、次のようなお品物をお買取りしています。掲載価格は参考価格です。</p><div class="mt-8 grid gap-5 sm:grid-cols-2">{purchaseExamples.map((purchaseCase) => <CaseCard item={purchaseCase} />)}</div></div></section>}

	<section class="mx-auto max-w-4xl px-5 py-16"><a href={link('/contact/')} class="inline-block rounded-full bg-ink-800 px-6 py-3 font-bold text-white">この品目について相談する</a></section>
</Layout>
