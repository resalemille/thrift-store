---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { items } from '../../data/items';
import CategoryLink from '../../components/CategoryLink.astro';
---

<Layout title="買取品目"
  ><PageHero
    title="買取品目"
    lead="価値がわからないお品物も、お気軽にお持ちください。"
    eyebrow="ITEMS"
  />
  <section
    class="silk-panel px-5 py-16 lg:px-8"
    aria-labelledby="categories-title"
  >
    <div class="mx-auto max-w-7xl">
      <h2 id="categories-title" class="ornament-title">
        買取対象カテゴリー一覧
      </h2>
      <p class="section-lead">幅広いお品物を、一点から丁寧に査定いたします。</p>
      <div class="category-grid">
        {items.map((item) => <CategoryLink item={item} />)}
      </div>
      <p
        class="mt-12 rounded-xl border border-stone-200 bg-white p-6 text-center text-sm leading-7 text-stone-600"
      >
        掲載にないお品物もご相談ください。状態や付属品の有無を問わず、専門スタッフが丁寧に確認します。
      </p>
    </div>
  </section></Layout
>
