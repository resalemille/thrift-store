---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { items } from '../../data/items';
import { link } from '../../lib/paths';
---

<Layout title="買取品目"
  ><PageHero
    title="買取品目"
    lead="価値がわからないお品物も、お気軽にお持ちください。"
    eyebrow="ITEMS"
  />
  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <a
          href={link(`/items/${item.slug}/`)}
          class={`rounded-2xl ${item.color} p-7`}
        >
          <span class="text-5xl">{item.icon}</span>
          <h2 class="mt-6 text-xl font-bold text-ink-950">{item.name}</h2>
          <p class="mt-2 text-sm text-stone-600">{item.description}</p>
          <span class="mt-6 block font-bold text-ink-800">詳しく見る →</span>
        </a>
      ))}
    </div>
    <p
      class="mt-12 rounded-xl border border-stone-200 bg-white p-6 text-center text-sm leading-7 text-stone-600"
    >
      掲載にないお品物もご相談ください。状態や付属品の有無を問わず、専門スタッフが丁寧に確認します。
    </p>
  </section></Layout
>
