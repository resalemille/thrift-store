---
import BrandIcon from '../../components/BrandIcon.astro';
import Layout from '../../layouts/Layout.astro';
import ConsignmentIcon from '../../components/ConsignmentIcon.astro';
import ConsignmentContacts from '../../components/ConsignmentContacts.astro';
import { consignmentFaqs } from '../../data/consignment';
import { site } from '../../data/site';
import { link } from '../../lib/paths';

const features = [
  {
    icon: 'crown',
    title: '業界唯一、売れる最高値を追求',
    text: '国内外の販売経路と市場の動向を踏まえ、お品物が売れる最高値を目指します。',
  },
  {
    icon: 'shield',
    title: '業界唯一、販売額も手数料も明確に',
    text: '販売額と手数料の内訳を明記。お手取り額まで、わかりやすくご案内します。',
  },
  {
    icon: 'collection',
    title: '業界最安値、手数料は1%から',
    text: '手数料を抑え、大切なお品物の価値をお客様のお手元へ。販売条件はご相談のうえ決定します。',
  },
];
const categories = [
  { icon: 'watch', title: '腕時計', text: '高級時計から国産時計まで' },
  { icon: 'brand', title: 'ブランド品', text: 'バッグ・財布・小物' },
  {
    icon: 'jewelry',
    title: 'ジュエリー',
    text: '指輪・ネックレス・ピアスなど',
  },
];
const comparisons = [
  {
    label: 'お預かり条件',
    cells: [
      '条件なし。',
      '100万以上かつロレックス等主要時計ブランドのみ',
      '30万以上（ヴィンテージを除く）',
      '100万以上の一部人気モデルのみ',
    ],
    marks: ['◎', '○', '○', '○'],
  },
  {
    label: '保管場所',
    cells: [
      '住所秘匿の保管場所（常駐の専用セキュリティ付き）',
      '店舗',
      '店舗',
      '店舗',
    ],
    marks: ['◎', '○', '○', '○'],
  },
  {
    label: '手数料',
    cells: [
      '1%〜',
      '800万円以上で3%（販売価格が不透明で実態は不明）',
      '7%（販売価格が不透明で実態は不明）',
      '5%＋消費税額 ※実質15%（販売価格が不透明で実態は不明）',
    ],
    marks: ['◎', '×', '×', '×'],
  },
  {
    label: '販売価格',
    cells: [
      'ご相談の上決定（市場で売れる最大金額を目指す）',
      '販売者が格安に決定',
      '販売者が格安に決定',
      '販売者が格安に決定',
    ],
    marks: ['◎', '×', '×', '◎'],
  },
  {
    label: '販売方法',
    cells: [
      '各ECサイト＋Googlemerchant広告＋SNS広告（一部店頭含む）',
      '店頭・ECサイト',
      '店頭',
      '店頭・ECサイト',
    ],
    marks: ['○', '○', '○', '○'],
  },
];
---

<Layout
  title="委託販売"
  description={`${site.name}の委託販売。腕時計・ブランド品・ジュエリーの売れる最高値を追求。販売額と手数料を明記し、手数料は1%から。`}
>
  <div class="consignment">
    <section
      class="home-hero consignment-hero"
      aria-labelledby="consignment-title"
    >
      <img
        src={link('/images/hero-resale-mille.webp')}
        alt="時計やバッグ、ジュエリーのある落ち着いた空間"
        class="hero-photo"
        width="2172"
        height="724"
        fetchpriority="high"
      >
      <div class="hero-content">
        <h1 id="consignment-title">
          <span>大切なお品物を、</span><span>価値ある委託販売へ。</span>
        </h1>
        <p>腕時計・ブランド品・ジュエリーの委託販売　{site.shortName}</p>
        <div class="hero-actions">
          <a href={link('/contact/')} class="framed-button"
            >無料でWeb査定・ご相談<span aria-hidden="true">›</span></a
          >
        </div>
      </div>
    </section>

    <section class="features silk-panel" aria-labelledby="features-title">
      <h2 id="features-title" class="ornament-title">
        {site.shortName}の委託販売が選ばれる理由
      </h2>
      <div class="feature-grid">
        {features.map((feature) => (
          <article class="consignment-reason gold-frame">
            <BrandIcon name={feature.icon} />
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))}
      </div>
    </section>
    <section
      class="consignment-categories silk-panel"
      aria-labelledby="categories-title"
    >
      <div class="consignment-ribbon" aria-hidden="true">
        {categories.map((category) => (
          <span>
            <BrandIcon name={category.icon} />
            {category.title}
          </span>
        ))}
      </div>
      <h2 id="categories-title" class="ornament-title">
        委託販売対象カテゴリー一覧
      </h2>
      <p class="section-lead">
        腕時計・ブランド品・ジュエリーの委託販売を承ります。
      </p>
      <div class="consignment-category-grid">
        {categories.map((category) => (
          <a href={link('/contact/')} class="consignment-category">
            <BrandIcon name={category.icon} />
            <span>
              <strong>{category.title}</strong>
              <small>{category.text}</small>
            </span>
            <span aria-hidden="true">›</span>
          </a>
        ))}
      </div>
    </section>

    <section class="comparison" aria-labelledby="comparison-title">
      <h2 id="comparison-title" class="section-heading">
        他社の委託販売との比較
      </h2>
      <p class="section-lead">
        {site.name}の委託販売は他社と比べて便利で安心。<br>手数料も業界最安値に設定しています。
      </p>
      <section
        class="table-scroll"
        tabindex="0"
        aria-label="委託販売の比較表。狭い画面では横にスクロールできます"
      >
        <table>
          <caption class="sr-only">
            他社の委託販売との比較
          </caption>
          <colgroup>
            <col class="label-column">
            <col class="our-column">
            <col>
            <col>
            <col>
          </colgroup>
          <thead>
            <tr>
              <td></td>
              <th scope="col">{site.name}</th>
              <th scope="col">A社</th>
              <th scope="col">B社</th>
              <th scope="col">C社</th>
            </tr>
          </thead>
          <tbody>
            {comparisons.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {row.cells.map((cell, index) => (
                  <td>
                    <span class="cell-content">
                      <span class="comparison-mark" aria-hidden="true">
                        {row.marks[index]}
                      </span>
                      <span>{cell}</span>
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </section>
      <p class="table-note">※現金決済の場合</p>
    </section>

    <section class="flow dark-panel" aria-labelledby="flow-title">
      <h2 id="flow-title" class="section-heading">ご利用の流れ</h2>
      <ol class="steps">
        <li>
          <span class="step-number">STEP 1</span>
          <h3>お申込み</h3>
          <div class="step-icon contact-icons">
            <ConsignmentIcon name="line" /><ConsignmentIcon name="phone" />
          </div>
          <p>お申し込みはLINE・メール・お電話でお気軽にご相談下さい。</p>
          <ConsignmentContacts compact />
        </li>
        <li>
          <span class="step-number">STEP 2</span>
          <h3>お預かり・撮影</h3>
          <div class="step-icon"><ConsignmentIcon name="camera" /></div>
          <p>
            郵送にて時計をお預かりし、状態の確認と販売用の写真撮影を行います。
          </p>
        </li>
        <li>
          <span class="step-number">STEP 3</span>
          <h3>価格決定・出品</h3>
          <div class="step-icon"><ConsignmentIcon name="watch" /></div>
          <p>
            販売希望価格をうかがい、商品の状態と相場を基に手数料を決定します。
          </p>
          <p>決定後は当店のECサイト等に出品いたします。</p>
        </li>
        <li>
          <span class="step-number">STEP 4</span>
          <h3>ご成約・ご入金</h3>
          <div class="step-icon"><ConsignmentIcon name="handshake" /></div>
          <p>
            成約した場合は、お品物をご成約者様へ納品し、金融機関にて3営業日以内にご入金いたします。
          </p>
        </li>
      </ol>
    </section>

    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="section-heading">よくあるご質問</h2>
      <div class="faq-list">
        {consignmentFaqs.map((faq) => (
          <details>
            <summary>
              <span class="question-label" aria-hidden="true">
                Q
              </span>
              <span>{faq.question}</span>
              <span class="chevron" aria-hidden="true"></span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section
      id="consignment-contact"
      class="contact dark-panel"
      aria-labelledby="contact-title"
    >
      <img
        class="contact-watch"
        src={link('/images/consignment/watch-cutout.png')}
        alt=""
        width="1024"
        height="1536"
        loading="lazy"
      >
      <h2 id="contact-title" class="section-heading">ご相談・お申し込み</h2>
      <p class="section-lead">お気軽にご相談ください！</p>
      <ConsignmentContacts />
      <p class="reception-hours">
        受付時間 11:00〜20:00　年中無休（年末年始除く）
      </p>
    </section>
  </div>
</Layout>

<style>
.consignment-hero {
  margin-inline: 0;
}
.consignment-hero .framed-button {
  color: #594621;
}
.consignment-hero h1 {
  font-size: clamp(23px, 3.4vw, 46px);
}
.consignment-hero .hero-actions {
  grid-template-columns: minmax(0, 360px);
  justify-content: center;
}
.consignment-categories .ornament-title {
  margin-bottom: 24px;
}

.consignment {
  --gold: #b5a77a;
  position: relative;
  isolation: isolate;
  overflow: hidden;
  color: #fff;
  background: #292929;
  padding: 0 0 48px;
  font-weight: 600;
  font-size: 14px;
  line-height: 1.75;
}
.consignment::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  opacity: 0.23;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' opacity='.32' d='M0 0h180v180H0z'/%3E%3C/svg%3E");
}
.consignment::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: linear-gradient(
    158deg,
    transparent 0 27%,
    #77777712 27% 43%,
    transparent 43% 65%,
    #77777716 65% 78%,
    transparent 78%
  );
}

a {
  color: inherit;
}
a:focus-visible,
summary:focus-visible,
.table-scroll:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 5px;
}
.introduction {
  position: relative;
  max-width: 980px;
  margin: 0 auto;
  padding-bottom: 48px;
}
.introduction::before,
.flow::before {
  content: none;
  position: absolute;
  z-index: -1;
  left: 50%;
  transform: translateX(-50%);
  color: #ffffff08;
  font:
    800 clamp(100px, 25vw, 380px) / 1 Arial,
    sans-serif;
  letter-spacing: -0.04em;
  pointer-events: none;
}
.introduction::before {
  top: 220px;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 38px;
  align-items: center;
}
h1 {
  text-wrap: balance;
  margin: 0 0 26px;
  font-size: clamp(24px, 3.5vw, 42px);
  line-height: 1.45;
  font-weight: 800;
  letter-spacing: -0.03em;
}
.hero-tagline {
  display: flex;
  align-items: center;
  gap: 20px;
}
.hero-tagline p {
  line-height: 2.3;
  margin: 0;
  font-size: 15px;
}
.fee-badge {
  flex: 0 0 86px;
  padding: 7px 3px;
  color: #c3b685;
  border: 1px solid var(--gold);
  text-align: center;
  font-size: 12px;
  line-height: 1.4;
}
.fee-badge strong {
  display: block;
  font-size: 28px;
  line-height: 1.1;
}
.fee-badge strong span {
  font-size: 15px;
}
.hero-image {
  width: 100%;
  height: auto;
  max-height: 360px;
  object-fit: contain;
}
.introduction-copy {
  margin: 38px auto 30px;
  text-align: center;
  line-height: 1.9;
  font-size: 13px;
}
.introduction-copy p {
  margin: 0;
}
.introduction-copy .second-paragraph {
  margin-top: 14px;
}
mark {
  background: #b5a77a99;
  color: white;
}
.consult-link {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 292px;
  min-height: 48px;
  margin: 0 auto;
  border: 1px solid var(--gold);
  color: #c3b685;
  text-decoration: none;
  font-size: 15px;
}
.dark-panel {
  position: relative;
  max-width: 1180px;
  margin: 0 auto;
  background: #09090980;
}
.section-heading {
  width: fit-content;
  position: relative;
  max-width: 100%;
  margin: 0 auto 40px;
  padding-bottom: 16px;
  text-align: center;
  font-size: clamp(23px, 2.6vw, 30px);
  font-weight: 800;
  line-height: 1.5;
}
.section-heading::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 160px;
  max-width: 75%;
  height: 1px;
  background: var(--gold);
}
.features {
  color: #302a20;
  padding: 48px 8.4% 62px;
}
.features .ornament-title {
  margin-bottom: 40px;
}
.feature-grid {
  max-width: 980px;
  margin-inline: auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 26px;
}
.feature-grid h3 {
  margin: 0;
  text-align: center;
  font-size: 16px;
  line-height: 1.5;
  font-weight: 700;
}
.feature-grid p {
  margin: 8px 0 0;
  font-size: 13px;
  line-height: 1.8;
}
small {
  font-size: 10px;
}
.consignment-reason {
  padding: 22px 16px 17px;
  text-align: center;
  background: #fffdf8;
}
.consignment-reason :global(svg) {
  width: 36px;
  height: 36px;
  margin: 0 auto 8px;
  color: #a28d55;
}
.consignment-categories {
  max-width: none;
  margin: 0 auto;
  padding: 0 0 48px;
  color: #302a20;
}
.consignment-categories h2 {
  margin-top: 40px;
}
.consignment-ribbon {
  display: flex;
  justify-content: center;
  gap: 12%;
  padding: 24px;
  background: #29261e;
  color: #e5d5a5;
}
.consignment-ribbon span {
  display: grid;
  justify-items: center;
  gap: 8px;
}
.consignment-ribbon :global(svg),
.consignment-category :global(svg) {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}
.consignment-category-grid {
  max-width: 1180px;
  margin-inline: auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  padding: 0 5%;
}
.consignment-category {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 24px 16px;
  border: 1px solid #ae995e;
  background: #fffdf8;
  text-decoration: none;
}
.consignment-category strong,
.consignment-category small {
  display: block;
}
.consignment-category small {
  font-size: 12px;
}
@media (max-width: 680px) {
  .consignment-category-grid {
    grid-template-columns: 1fr;
  }
}
.comparison {
  width: calc(100% - 40px);
  max-width: 980px;
  margin: 0 auto;
  padding: 48px 0 44px;
}
.section-lead {
  margin: 0 0 44px;
  color: inherit;
  text-align: center;
  font-size: 14px;
  line-height: 1.8;
}
.comparison .section-heading {
  margin-bottom: 38px;
}
.table-scroll {
  overflow-x: auto;
}
table {
  width: 100%;
  min-width: 620px;
  border-collapse: collapse;
  table-layout: fixed;
  text-align: left;
  font-size: 13px;
  line-height: 1.5;
}
.label-column {
  width: 18%;
}
.our-column {
  width: 26%;
  background: #18181855;
}
th,
td {
  border: 1px solid #131313;
  padding: 17px 13px;
  vertical-align: middle;
}
thead td {
  border: 0;
  background: transparent;
}
thead th {
  background: #555555a6;
  text-align: center;
}
thead th:nth-child(2) {
  background: #a69c75;
  border-color: var(--gold);
}
tbody th {
  background: #70707080;
  font-weight: 600;
}
tbody td {
  background: #55555566;
}
tbody td:nth-child(2) {
  background: #18181855;
  border: 1px solid var(--gold);
}
tbody tr:nth-child(3) td:nth-child(2) {
  color: #c8bb87;
  font-size: 23px;
  font-weight: 800;
}
.cell-content {
  display: flex;
  align-items: center;
  gap: 12px;
}
.comparison-mark {
  color: #b5a77a;
  font-size: 24px;
  font-weight: 400;
}
.table-note {
  margin: 6px 0 0;
  text-align: right;
  font-size: 10px;
}
.flow {
  padding: 50px 8% 48px;
}
.flow::before {
  top: -70px;
}
.steps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 28px;
  padding: 0;
  margin: 60px 0 0;
  list-style: none;
}
.steps li {
  position: relative;
  border: 1px solid #aca99a;
  padding: 27px 13px 19px;
}
.steps li:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 48%;
  right: -22px;
  border-left: 12px solid #a9a698;
  border-top: 14px solid transparent;
  border-bottom: 14px solid transparent;
}
.step-number {
  position: absolute;
  top: -13px;
  left: 50%;
  transform: translateX(-50%);
  padding: 0 12px;
  white-space: nowrap;
  background: #1c1c1c;
  color: #b5a77a;
  font-size: 16px;
  font-weight: 700;
}
.steps h3 {
  margin: 0;
  text-align: center;
  font-size: 16px;
  font-weight: 700;
}
.step-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 85px;
  color: #b5a77a;
}
.step-icon :global(svg) {
  width: 63px;
  height: 63px;
}
.contact-icons :global(svg) {
  width: 43px;
  height: 43px;
}
.steps p {
  margin: 0 0 19px;
  font-size: 13px;
  line-height: 1.8;
  text-align: center;
  overflow-wrap: anywhere;
}
.steps p:last-child {
  margin-bottom: 0;
}
.faq {
  width: calc(100% - 40px);
  max-width: 800px;
  margin: 0 auto;
  padding: 52px 0;
}
.faq-list {
  display: grid;
  gap: 14px;
}
.faq details {
  border: 1px solid #a4a091;
  background: #22222255;
}
.faq summary {
  display: flex;
  align-items: center;
  gap: 18px;
  min-height: 60px;
  padding: 17px;
  cursor: pointer;
  list-style: none;
  font-size: 14px;
}
.question-label {
  color: #bdaf7f;
  font-size: 22px;
  font-weight: 400;
  line-height: 1;
}
.chevron {
  width: 7px;
  height: 7px;
  margin-left: auto;
  margin-right: 5px;
  flex: 0 0 auto;
  border-right: 1px solid var(--gold);
  border-bottom: 1px solid var(--gold);
  transform: rotate(45deg);
}
details[open] .chevron {
  transform: rotate(225deg);
}
.faq details p {
  border-top: 1px solid #a4a09166;
  margin: 0;
  padding: 18px 20px 22px 51px;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.9;
}
.contact {
  margin-top: 0;
  padding: 50px 8% 48px;
  scroll-margin-top: 110px;
}
.contact-watch {
  position: absolute;
  width: 145px;
  height: 205px;
  object-fit: contain;
  right: 15%;
  top: -45px;
  pointer-events: none;
}
.contact .section-heading {
  margin-bottom: 36px;
}
.contact .section-lead {
  margin-bottom: 44px;
}
.reception-hours {
  text-align: center;
  margin: 6px 0 0;
  font-size: 9px;
}
@media (max-width: 900px) {
