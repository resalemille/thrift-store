---
import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import { brands } from '../../data/site';
---
<Layout title="買取強化ブランド"><PageHero title="買取強化ブランド" lead="バッグ、時計、ジュエリーなどの人気ブランドを積極的にお取り扱いしています。" eyebrow="BRANDS" /><section class="mx-auto max-w-7xl px-5 py-16 lg:px-8"><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{brands.map((brand, index) => <article class="grid aspect-[4/3] place-items-center rounded-2xl border border-stone-200 bg-white p-6 text-center shadow-sm"><span><span class="mb-4 block text-3xl">{['◇', '○', '□', '△'][index % 4]}</span><h2 class="font-bold text-ink-950">{brand}</h2><p class="mt-2 text-xs text-stone-500">ダミー掲載</p></span></article>)}</div></section></Layout>
