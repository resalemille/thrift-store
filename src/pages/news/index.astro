---
import ContentContainer from '../../components/ContentContainer.astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { news } from '../../data/news';
---

<Layout title="お知らせ"
  ><PageHero
    title="お知らせ"
    lead="買取のResale Mille（リセールミル）からのお知らせです。"
    eyebrow="NEWS"
  />
  <ContentContainer width="reading">
    <div class="divide-y divide-stone-200 border-y border-stone-200">
      {news.map((item) => (
        <article class="flex flex-col gap-3 py-6 sm:flex-row sm:items-center">
          <time class="w-28 text-sm text-stone-400">{item.date}</time>
          <span class="w-fit rounded bg-ink-50 px-3 py-1 text-xs font-bold text-ink-800">
            {item.category}
          </span>
          <h2 class="font-bold text-ink-950">{item.title}</h2>
        </article>
      ))}
    </div>
  </ContentContainer></Layout
>
